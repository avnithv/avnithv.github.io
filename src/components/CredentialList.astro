---
import { inlineMd } from '../lib/markdown';
import { opensInNewTab } from '../lib/links';

// List of honors/awards. Each item renders as a row with a title (+ optional
// org), an optional markdown description, an optional link, and a right-aligned
// `meta` (the year). When the list is longer than `limit`, the overflow is
// tucked into a native <details> with a "see more" toggle at the bottom.
//
//  • href — internal detail page (/honors/<slug>). When set, a visible
//           "details →" link is shown (same slot as the external link), and the
//           inline `link` is not shown — put it on the detail page instead.
//  • link — a resource URL, shown only when there is no detail page.
//           Opens in a new tab (↗) when it leaves the in-site page flow — an
//           external URL or a standalone file (see opensInNewTab); otherwise
//           same tab (→), e.g. an in-site path like /projects/foo.
export interface CredentialItem {
  title: string;
  org?: string;
  description?: string;
  meta: string;
  href?: string;
  link?: string;
  linkText?: string;
}

interface Props {
  items: CredentialItem[];
  limit?: number;
}

const { items, limit = 3 } = Astro.props;
const visible = items.slice(0, limit);
const hidden = items.slice(limit);
---
<div class="honors">
  {visible.map((h) => (
    <div class="row honor">
      <div class="honor-main">
        <span class="title">
          {h.title}
          {h.org && <span class="honor-body"> — {h.org}</span>}
        </span>
        {h.description && <p set:html={inlineMd(h.description)} />}
        {h.href ? (
          <a class="honor-link" href={h.href}>{h.linkText ?? 'details'} <span aria-hidden="true">→</span></a>
        ) : h.link && (
          opensInNewTab(h.link) ? (
            <a class="honor-link" href={h.link} target="_blank" rel="noopener">
              {h.linkText ?? 'learn more'} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <a class="honor-link" href={h.link}>
              {h.linkText ?? 'more'} <span aria-hidden="true">→</span>
            </a>
          )
        )}
      </div>
      <span class="meta">{h.meta}</span>
    </div>
  ))}

  {hidden.length > 0 && (
    <details class="see-more">
      <summary class="see-more-btn">
        <span class="see-more-open">see more ({hidden.length}) <span aria-hidden="true">↓</span></span>
        <span class="see-more-close">see less <span aria-hidden="true">↑</span></span>
      </summary>
      {hidden.map((h) => (
        <div class="row honor">
          <div class="honor-main">
            <span class="title">
              {h.title}
              {h.org && <span class="honor-body"> — {h.org}</span>}
            </span>
            {h.description && <p set:html={inlineMd(h.description)} />}
            {h.href ? (
              <a class="honor-link" href={h.href}>{h.linkText ?? 'details'} <span aria-hidden="true">→</span></a>
            ) : h.link && (
              opensInNewTab(h.link) ? (
                <a class="honor-link" href={h.link} target="_blank" rel="noopener">
                  {h.linkText ?? 'learn more'} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <a class="honor-link" href={h.link}>
                  {h.linkText ?? 'more'} <span aria-hidden="true">→</span>
                </a>
              )
            )}
          </div>
          <span class="meta">{h.meta}</span>
        </div>
      ))}
    </details>
  )}
</div>

<style>
  .honors { margin-top: 1.5rem; }
  .honor { align-items: start; }
  .honor-main { display: flex; flex-direction: column; }
  .honor-body { color: var(--muted); font-weight: 400; }
  .honor-link {
    margin-top: 0.3rem;
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--accent);
  }

  /* "see more" toggle — native <details>, no JS required */
  .see-more-btn {
    list-style: none;
    cursor: pointer;
    display: inline-block;
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
    user-select: none;
  }
  .see-more-btn::-webkit-details-marker { display: none; }
  .see-more-btn:hover { color: var(--accent-2); }
  .see-more-close { display: none; }
  .see-more[open] .see-more-open { display: none; }
  .see-more[open] .see-more-close { display: inline; }
</style>
