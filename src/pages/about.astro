---
import Base from '../layouts/Base.astro';
---
<Base title="About — Avnith Vijayram" description="About Avnith Vijayram — computational biology & AI at Carnegie Mellon.">
  <p class="eyebrow">about</p>
  <h1>Hi, I'm Avnith</h1>
  <div class="about">
    <figure class="about-photo">
      <!--
        Drop a photo at site/public/avnith.jpg (or .png) and the image below
        will render it. Until then, the styled placeholder shows your initials.
      -->
      <img src="/avnith.jpg" alt="Avnith Vijayram" onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'about-photo-placeholder',textContent:'AV'}))" />
    </figure>

    <div class="about-story prose">
      <p>
        I'm a student at Carnegie Mellon studying computational biology and AI. 
        
        My interests are in applying AI models to omics data to identify mechanisms and targets behind disease. 
        Right now, I'm particularly interested in drug discovery, biological foundation models, generative models, and transformer architectures. 
      </p>
      <p>
        In Dr.
        Jennifer Kwan's lab at Yale I've studied the
        <a href="/projects/cardiotoxicity">mechanisms behind cardiotoxicity and
        ICI myocarditis →</a>, and I built <a href="/projects/gliograde">GlioGrade →</a>,
        an ML tool that diagnoses gliomas from MRI scans, now used by
        neuropathologists at three clinics. I've also volunteered at
        <a href="/projects/novascriptscentral">NOVA ScriptsCentral →</a>, transforming
        nearly two decades of medication records into dashboards and getting to
        experience the human side of healthcare.
      </p>
      <p>
        Outside of research I'm an avid <a href="/projects/compprog">competitive
        programmer →</a> and aspiring ultimate frisbee player.
      </p>

    </div>
  </div>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-top: 2rem;
  }
  .about-photo { margin: 0; }
  .about-photo img,
  .about-photo :global(.about-photo-placeholder) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--bg-2);
  }
  /* placeholder shown until a real photo is added */
  .about-photo :global(.about-photo-placeholder) {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Space Grotesk', var(--sans);
    font-weight: 700;
    font-size: 3rem;
    letter-spacing: -0.02em;
    color: var(--faint);
  }
  .about-photo figcaption {
    margin-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--faint);
    text-align: center;
  }
  .about-story { max-width: 60ch; }

  @media (max-width: 640px) {
    .about { grid-template-columns: 1fr; gap: 1.75rem; }
    .about-photo { max-width: 220px; }
  }
</style>
