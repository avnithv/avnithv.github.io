---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const fmt = (d: Date) =>
  // timeZone: UTC — see the note in src/pages/blog/index.astro.
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={`${post.data.title} — Avnith Vijayram`} description={post.data.description}>
  <p class="eyebrow">{fmt(post.data.date)}</p>
  <h1>{post.data.title}</h1>
  {post.data.tags.length > 0 && (
    <div class="tags">
      {post.data.tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  )}
  {post.data.image && (
    <img class="post-cover" src={post.data.image} alt={`${post.data.title} cover`} />
  )}
  <article class="prose" style="margin-top:1.5rem">
    <Content />
  </article>
  <p style="margin-top:2.5rem"><a href="/blog">← all posts</a></p>
</Base>

<style>
  .post-cover {
    display: block;
    width: 100%;
    max-height: 320px;
    object-fit: cover;
    border-radius: 12px;
    margin-top: 1.5rem;
  }
</style>
