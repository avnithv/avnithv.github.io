---
import Base from '../../layouts/Base.astro';
import { inlineMd } from '../../lib/markdown';
import { getOrdered } from '../../lib/collections';

// Order is controlled in one place: src/site-order.ts (unlisted posts fall
// back to newest-first).
const posts = (await getOrdered('blog')).filter((p) => !p.data.draft);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Filter tags are derived from the tags on existing posts, sorted by how
// often they appear (most common first), then alphabetically to break ties.
const tagCounts = new Map<string, { label: string; count: number }>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const key = tag.toLowerCase();
    const entry = tagCounts.get(key);
    if (entry) entry.count++;
    else tagCounts.set(key, { label: tag, count: 1 });
  }
}
const FILTER_TAGS = [...tagCounts.values()]
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))
  .map((t) => t.label);

const tagKey = (tags: string[]) => `|${tags.map((t) => t.toLowerCase()).join('|')}|`;
---
<Base title="Blog — Avnith Vijayram">
  <p class="eyebrow">blog</p>
  <h1>Things I've written</h1>
  <p class="lede">mostly random stuff I've been working on or found interesting</p>

  <div class="tag-filter" role="group" aria-label="Filter posts by tag">
    <button class="filter-btn is-active" type="button" data-tag="" aria-pressed="true">all</button>
    {FILTER_TAGS.map((t) => (
      <button class="filter-btn" type="button" data-tag={t.toLowerCase()} aria-pressed="false">{t}</button>
    ))}
  </div>

  <div class="post-list">
    {posts.length === 0 && <p class="lede">No posts yet — coming soon.</p>}
    {posts.map((post) => (
      <a class="post-card" href={`/blog/${post.slug}`} data-tags={tagKey(post.data.tags)}>
        {post.data.image && (
          <img class="post-thumb" src={post.data.image} alt={`${post.data.title} cover`} loading="lazy" />
        )}
        <div class="post-body">
          <div class="post-head">
            <span class="post-title">{post.data.title}</span>
            <span class="post-date">{fmt(post.data.date)}</span>
          </div>
          {post.data.description && <p class="post-desc" set:html={inlineMd(post.data.description)} />}
          {post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          )}
          <span class="post-readmore">read post →</span>
        </div>
      </a>
    ))}
  </div>
  <p id="no-match" class="lede" hidden>No posts with that tag yet.</p>
</Base>

<script is:inline>
  (() => {
    const buttons = Array.from(document.querySelectorAll('.filter-btn'));
    const cards = Array.from(document.querySelectorAll('.post-card'));
    const noMatch = document.getElementById('no-match');
    if (!buttons.length) return;

    function apply(tag) {
      let shown = 0;
      cards.forEach((card) => {
        const match = tag === '' || (card.dataset.tags || '').includes('|' + tag + '|');
        card.hidden = !match;
        if (match) shown++;
      });
      if (noMatch) noMatch.hidden = shown !== 0;
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.toggle('is-active', b === btn);
          b.setAttribute('aria-pressed', String(b === btn));
        });
        apply(btn.dataset.tag || '');
      });
    });
  })();
</script>

<style>
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  .filter-btn {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: #0d5236;
    background: rgba(14, 140, 82, 0.08);
    border: 1px solid rgba(14, 140, 82, 0.25);
    border-radius: 999px;
    padding: 5px 13px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .filter-btn:hover { border-color: rgba(14, 140, 82, 0.55); }
  .filter-btn.is-active {
    background: #0e8c52;
    border-color: #0e8c52;
    color: #fff;
  }
  .tag-filter + .post-list { margin-top: 1.5rem; }
  /* the [hidden] attribute is overridden by .post-card's display:flex, so force it */
  .post-card[hidden] { display: none; }
</style>
