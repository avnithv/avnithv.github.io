---
import Base from '../layouts/Base.astro';
import { getOrdered, hasBody } from '../lib/collections';
import CredentialList from '../components/CredentialList.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Order is controlled in one place: src/site-order.ts.
const projects = await getOrdered('projects');

// Show the first handful; the rest tuck into a "see more" dropdown.
const PROJECT_LIMIT = 6;
const visible = projects.slice(0, PROJECT_LIMIT);
const hidden = projects.slice(PROJECT_LIMIT);

// Honors live in src/content/honors/ — add a markdown file to add one.
const honors = await getOrdered('honors');
const honorItems = honors.map((h) => ({
  ...h.data,
  meta: h.data.year,
  href: hasBody(h) ? `/honors/${h.slug}` : undefined,
}));
---
<Base title="Projects — Avnith Vijayram">
  <p class="eyebrow">projects</p>
  <h1>Things I've done</h1>
  <p class="lede">a mix of computational biology and ML research, plus projects I've built for competitions, community, and fun.</p>

  {honors.length > 0 && (
    <p class="jump"><a href="#honors">honors &amp; awards <span aria-hidden="true">↓</span></a></p>
  )}

  <div class="project-grid">
    {visible.map((p) => <ProjectCard project={p} />)}
  </div>

  {hidden.length > 0 && (
    <details class="see-more">
      <summary class="see-more-btn">
        <span class="see-more-open">see more ({hidden.length}) <span aria-hidden="true">↓</span></span>
        <span class="see-more-close">see less <span aria-hidden="true">↑</span></span>
      </summary>
      <div class="project-grid see-more-grid">
        {hidden.map((p) => <ProjectCard project={p} />)}
      </div>
    </details>
  )}

  {honors.length > 0 && (
    <>
      <hr />
      <p id="honors" class="eyebrow">honors &amp; awards</p>
      <CredentialList items={honorItems} />
    </>
  )}
</Base>

<style>
  .jump {
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  /* "see more" toggle — native <details>, no JS required (mirrors CredentialList) */
  .see-more-grid { margin-top: 1.25rem; }
  .see-more-btn {
    list-style: none;
    cursor: pointer;
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
    user-select: none;
  }
  .see-more-btn::-webkit-details-marker { display: none; }
  .see-more-btn:hover { color: var(--accent-2); }
  .see-more-close { display: none; }
  .see-more[open] .see-more-open { display: none; }
  .see-more[open] .see-more-close { display: inline; }
</style>
