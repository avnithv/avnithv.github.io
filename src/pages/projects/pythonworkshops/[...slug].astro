---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pythonworkshops');
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await page.render();

// Readable <title> from the last path segment (e.g. workshop1/lessons/intro → "Intro").
const last = page.slug.split('/').pop() ?? page.slug;
const pretty = last.replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const isHome = page.slug === 'home';
---
<Base title={`${pretty} — Python Workshops`} description="Python Programming Lessons by Avnith Vijayram.">
  <p class="eyebrow">
    <a href="/projects/pythonworkshops">python workshops</a>
    {!isHome && <> · <a href="/projects/pythonworkshops/home">all lessons</a></>}
  </p>
  <article class="prose">
    <Content />
  </article>
</Base>
